# Copy to .env.local (git-ignored). Only these two values ever reach the browser.
# Your Supabase project: Settings > API (URL) and Settings > API Keys (publishable key). See docs/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Local stack instead: values from `npx supabase status` (API URL http://127.0.0.1:54321).
#
# The secret/service-role key is NOT used by this app. It belongs only in Edge Function secrets
# (`supabase secrets set`). Never prefix it with NEXT_PUBLIC_, never commit it, never paste it in chat.
#
# Optional, app host only (docker-compose.yml): scan every task-file upload with ClamAV. See docs/RUNBOOK.md.
# TASK_FILE_SCAN=required
# The purge job (scripts/purge-task-files.mjs) reads SUPABASE_URL and SUPABASE_SECRET_KEY from its own env file
# (~/.config/hardcode-ops/purge.env), not from .env.local.
#
# The assistant (app host only): encrypts each person's own Gemini key before it is stored. Generate with `openssl rand -base64 32`.
# Keep a copy somewhere safe; if it is lost, everyone has to add their key again. Unset = the assistant is switched off.
# AI_KEY_SECRET=
#
# Email notifications: scripts/send-emails.mjs reads SUPABASE_URL, SUPABASE_SECRET_KEY, RESEND_API_KEY, MAIL_FROM and APP_URL
# from its own env file (~/.config/hardcode-ops/mail.env), not from .env.local. See docs/RUNBOOK.md, "Email notifications".
