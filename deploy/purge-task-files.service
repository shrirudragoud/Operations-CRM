# systemd user unit: removes task files that were deleted 30+ days ago and stray uploads. Not installed by the repo.
[Unit]
Description=Hard-Code Ops: purge task files

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Codebase V 4/OPS CRM/Operations-CRM
# Holds SUPABASE_URL and SUPABASE_SECRET_KEY. Keep it chmod 600, outside the repo, never committed.
EnvironmentFile=%h/.config/hardcode-ops/purge.env
ExecStart=/usr/bin/env node scripts/purge-task-files.mjs
